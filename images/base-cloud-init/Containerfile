FROM quay.io/almalinuxorg/almalinux-bootc:10@sha256:55a2793612b208791c8c08b364629dbb5f836b314a91f1471c13465b4a84f230

RUN dnf install -y \
        cloud-init cloud-utils-growpart \
        vim \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN systemctl enable cloud-init.service \
                     bootc-fetch-apply-updates.timer

RUN echo export EDITOR=vim >> /etc/profile.d/99-editor-vim.sh

RUN bootc container lint
