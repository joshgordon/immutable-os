FROM quay.io/almalinuxorg/almalinux-bootc:10@sha256:3cf98cf959b852dc95e9a427a1e76c0f551108aab73c1255bbe97915215a6738

RUN dnf install -y \
        cloud-init cloud-utils-growpart \
        nginx \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN systemctl enable cloud-init.service nginx.service \
                     bootc-fetch-apply-updates.timer

RUN bootc container lint
