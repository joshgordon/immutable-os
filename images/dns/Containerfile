FROM ghcr.io/joshgordon/immutable-os/bao-agent:latest@sha256:4f8d4e6af5056fc67e10c7bbf02562fb8df0ff41269b3a8425f0a8d298e4fad3

# DNS-specific bao templates and agent config drop-in
COPY bao/ /etc/bao/

# AdGuard, cf-rdns, adguardhome-sync Quadlets
COPY containers/ /etc/containers/systemd/

# Persistent data dirs for AdGuard work/conf/certs volumes
COPY tmpfiles.d/ /usr/lib/tmpfiles.d/

RUN bootc container lint
