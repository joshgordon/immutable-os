FROM quay.io/almalinuxorg/almalinux-bootc:10@sha256:f1a90b5d1d0a4b9c34f21ae0b69f11e99237d4c0f280d4b6c60cf208820b774e

RUN dnf install -y \
        vim \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN echo export EDITOR=vim >> /etc/profile.d/99-editor-vim.sh

# /run/secrets is tmpfs at runtime; bao-secrets.conf creates it at every boot
COPY tmpfiles.d/ /usr/lib/tmpfiles.d/

# Quadlet unit and agent config directory (no secrets — those arrive at bootstrap)
COPY containers/ /etc/containers/systemd/
COPY bao/        /etc/bao/

RUN systemctl enable podman-auto-update.timer bootc-fetch-apply-updates.timer

RUN bootc container lint
