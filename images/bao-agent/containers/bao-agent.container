[Unit]
Description=OpenBao Agent
# Hold until an operator writes role-id at bootstrap
ConditionPathExists=/etc/bao/role-id

[Container]
Image=docker.io/openbao/openbao:latest@sha256:71156a1c6623a5fa3f5e61b0c6a8ead0faf0df29a778339188443551995d1315
User=root
Exec=bao agent -config=/etc/bao/agent.d/
Volume=/etc/bao:/etc/bao:Z
Volume=/var/lib/bao:/var/lib/bao:Z
Volume=/run/secrets:/run/secrets:Z
# Reads VAULT_ADDR from /etc/bao/server.env on the host.
# Edit that file at bootstrap; the 3-way merge preserves it across upgrades.
EnvironmentFile=/etc/bao/server.env
Environment=BAO_CACERT=/etc/bao/ca.crt
AutoUpdate=registry

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target default.target
