FROM ghcr.io/joshgordon/immutable-os/base-cloud-init:latest

# NVIDIA 580xx driver from RPM Fusion. This is the last branch that supports
# Pascal cards like the Quadro P600, and it has to be compiled for the kernel.
RUN set -eux; \
    KVER="$(ls /usr/lib/modules)"; \
    test "$(echo "$KVER" | wc -l)" -eq 1; \
    dnf install -y epel-release; \
    crb enable; \
    EL="$(rpm -E %rhel)"; \
    dnf install -y \
        "https://mirrors.rpmfusion.org/free/el/rpmfusion-free-release-$EL.noarch.rpm" \
        "https://mirrors.rpmfusion.org/nonfree/el/rpmfusion-nonfree-release-$EL.noarch.rpm"; \
    dnf install -y "kernel-devel-$KVER" "kernel-modules-$KVER" "kernel-modules-extra-$KVER"; \
    dnf install -y akmod-nvidia-580xx xorg-x11-drv-nvidia-580xx-cuda; \
    rpm -qa 'kernel*' 'akmod*' 'xorg-x11-drv-nvidia*' | sort; \
    akmods --force --kernels "$KVER" \
        || { cat /var/cache/akmods/*/*.failed.log 2>/dev/null || true; exit 1; }; \
    test "$(ls /usr/lib/modules | wc -l)" -eq 1; \
    depmod -a "$KVER"; \
    modinfo -k "$KVER" nvidia > /dev/null; \
    ldconfig; \
    ldconfig -p | grep -q libnvidia-encode; \
    ldconfig -p | grep -q libnvcuvid; \
    dnf clean all; \
    rm -rf /var/cache/dnf /var/cache/akmods

# Keep nouveau from claiming the GPU
RUN mkdir -p /usr/lib/bootc/kargs.d \
    && echo 'kargs = ["rd.driver.blacklist=nouveau", "modprobe.blacklist=nouveau"]' \
        > /usr/lib/bootc/kargs.d/10-nvidia.toml

# NVIDIA Container Toolkit generates the CDI spec Podman uses for GPU access
RUN set -eux; \
    curl -fsSL https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo \
        -o /etc/yum.repos.d/nvidia-container-toolkit.repo; \
    dnf install -y nvidia-container-toolkit-base; \
    dnf clean all; \
    rm -rf /var/cache/dnf

# Plex Quadlet and persistent data dirs
COPY containers/ /etc/containers/systemd/
COPY tmpfiles.d/ /usr/lib/tmpfiles.d/

# Check for OS updates at 3am Eastern instead of bootc's default interval
COPY systemd/ /usr/lib/systemd/system/
RUN systemd-analyze calendar '*-*-* 03:00:00 America/New_York' > /dev/null

RUN systemctl enable bootc-fetch-apply-updates.timer \
                     podman-auto-update.timer \
                     nvidia-cdi-refresh.path \
                     nvidia-cdi-refresh.service

RUN bootc container lint
